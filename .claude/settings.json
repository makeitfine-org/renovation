{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "auto",
    "MAX_THINKING_TOKENS": 10000,
    "MAX_MCP_OUTPUT_TOKENS": 10000,
    "CLAUDE_CODE_MAX_RETRIES": 5
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew :*)",
      "Bash(./gradlew ktlintCheck*)",
      "Bash(./gradlew ktlintFormat*)",
      "Bash(./gradlew detekt*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew integrationTest*)",
      "Bash(./gradlew e2eTest*)",
      "Bash(./gradlew buildAll*)",
      "Bash(./gradlew assemble*)",
      "Bash(./gradlew build*)",
      "Bash(./gradlew clean*)",
      "Bash(./gradlew koverVerify*)",
      "Bash(./gradlew installGitHooks*)",
      "Bash(docker compose*)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(npm run*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(wc -l *)",
      "Bash(awk *)",
      "Bash(xargs *)",
      "Bash(ls *)",
      "Bash(jq *)",
      "Bash(curl -s http://localhost:*)",
      "mcp__postgres-renovation__query",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ],
    "deny": [
      "Bash(git push --force*:main)",
      "Bash(git push --force*:develop)",
      "Bash(git push -f*:main)",
      "Bash(git push -f*:develop)",
      "Bash(git reset --hard origin/*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf $HOME*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "postgres-renovation",
    "mongodb-renovation"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/warn-build-output-edit.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-commit-msg.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ktlint-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify-test-fail.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\u001b[36m\\(.model.display_name)\\u001b[0m | context: \\u001b[33m\\(.context_window.used_percentage // 0)%\\u001b[0m | limit: \\u001b[32m\\(.rate_limits.five_hour.used_percentage)% [\\(.rate_limits.five_hour.resets_at | strflocaltime(\"%H:%M\"))]\\u001b[0m\"'"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false
  }
}
